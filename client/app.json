{
  "package_id": "com.mikeleet.ghostpeek",
  "name": "GhostPeek",
  "version": "0.1.6",
  "edition": "202601",
  "min_app_version": "2.0.0",
  "min_sdk_version": "0.0.11",
  "entrypoint": "index.html",
  "permissions": [
    {
      "name": "network",
      "desc": "Connect to GhostPeek bridge",
      "whitelist": [
        "ws://127.0.0.1:8787", "http://127.0.0.1:8787",
        "ws://localhost:8787", "http://localhost:8787",
        "ws://192.168.0.32:8787", "http://192.168.0.32:8787",
        "http://192.168.0.32:5173"
      ]
    },
    {
      "name": "camera",
      "desc": "Scan QR code to configure bridge connection"
    }
  ],
  "supported_languages": ["en"]
}
